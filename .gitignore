
# Root gitignore

.DS_Store
.idea
.vscode
*.log

# Ignore sub-project dependencies
node_modules
dist
bin
tmp
coverage
.env
.env.*
# Delve debug binaries (VS Code Go extension)
backend/main

# Throwaway historical-import tooling — script + generated reports + python cache.
# This folder will be deleted once the historical backfill is finished.
scripts/historical-import/

# Personal/info documents (office files, PDFs) — kept locally only, not code
*.xlsx
*.xls
*.csv
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.key
*.pages
*.numbers

# Ignore scratch folders and their contents
scratch/
**/scratch/

# Local-only demo/diagnostic tooling. Hardcodes a localhost DSN and demo
# credentials and is only ever run by hand against a developer's own database,
# so it stays out of the repo.
backend/cmd/seed_demo/

# Local-only database seed data, run by hand against a developer's own database.
# Not to be confused with internal/sql/migrations, which IS tracked and is the
# only thing go:embed picks up (see migrations_embeded.go).
backend/internal/sql/seeds/


